{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listenbox desktop",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/desktop",
      "program": "lib/main.dart",
      "env": {
        "LISTENBOX_CONFIG": "${workspaceFolder}/config/dev.yaml"
      },
      "flutterMode": "debug"
    },
    {
      "name": "Listenbox CLI help",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/cli",
      "program": "bin/listenbox.dart",
      "args": ["--help"]
    }
  ]
}
